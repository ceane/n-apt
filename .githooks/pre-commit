#!/bin/sh

set -eu

ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"

if command -v node >/dev/null 2>&1; then
  NODE_BIN=$(command -v node)
elif [ -x "/Users/ceanelamerez/.cache/codex-runtimes/codex-primary-runtime/dependencies/node/bin/node" ]; then
  NODE_BIN="/Users/ceanelamerez/.cache/codex-runtimes/codex-primary-runtime/dependencies/node/bin/node"
else
  echo "pre-commit: Node.js is required to synchronize article channel frequencies." >&2
  exit 1
fi

"$NODE_BIN" scripts/article/sync-channel-frequencies.mjs --write

# The synchronizer intentionally updates generated article text as part of the
# commit so a signals.yaml channel edit cannot leave either article copy stale.
git add -- pages/how-do-they-do-it.md docs/pages/how-do-they-do-it.md
